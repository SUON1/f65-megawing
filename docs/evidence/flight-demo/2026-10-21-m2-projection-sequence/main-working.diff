+// Private owner validation against the already captured immutable transform.
+// Public record_valid/pair_eligible retain their independent reconstruction.
+uint8_t m2_registration_matches_prepared(const struct M2Prepared *prepared,
+    const M2Registration *record, uint32_t generation, uint32_t tick, uint8_t store)
+{
+    if (prepared == 0 || prepared->ready != 1u || record == 0
+        || generation == 0u || store > 1u || record->generation != generation
+        || record->source_tick != tick || record->store != store
+        || record->fixture_revision != M2_FIXTURE_REVISION
+        || record->projection_revision != M2_PROJECTION_REVISION
+        || record->composition_revision != M2_COMPOSITION_REVISION
+        || record->view_id != 0u || record->tier_id != 0u
+        || record->camera.revision != prepared->camera.revision
+        || record->camera.yaw != prepared->camera.yaw
+        || record->camera.pitch != prepared->camera.pitch
+        || record->camera.roll != prepared->camera.roll)
+    {
+        return 0u;
+    }
+    for (uint8_t i = 0u; i < 3u; ++i)
+    {
+        if (record->camera.position.v[i] != prepared->camera.position.v[i])
+        {
+            return 0u;
+        }
+    }
+    for (uint8_t i = 0u; i < 9u; ++i)
+    {
+        if (record->transform.m[i] != prepared->rotation.m[i])
+        {
+            return 0u;
+        }
+    }
+    return 1u;
+}
