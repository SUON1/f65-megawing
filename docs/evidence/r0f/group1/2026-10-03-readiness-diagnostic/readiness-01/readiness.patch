+uint8_t r0fg1_export_begin_diagnostic(r0fg1_export *export,
+                                     const r0fg1_export_readiness *readiness)
+{
+    if (export == 0 || export->state != R0FG1X_S_FROZEN)
+    {
+        return 0x70u;
+    }
+    uint8_t reason = 0u;
+    if (readiness == 0)
+    {
+        reason = 0x71u;
+    }
+    else if (readiness->acquisition_stopped != 1u)
+    {
+        reason = 0x72u;
+    }
+    else if (readiness->dma_empty != 1u)
+    {
+        reason = 0x73u;
+    }
+    else if (readiness->display_stopped != 1u)
+    {
+        reason = 0x74u;
+    }
+    else if (readiness->audio_stopped != 1u)
+    {
+        reason = 0x75u;
+    }
+    else if (readiness->irq_masked != 1u)
+    {
+        reason = 0x76u;
+    }
+    else if (readiness->rom_verified != 1u)
+    {
+        reason = 0x77u;
+    }
+    else if (readiness->capsule_verified != 1u)
+    {
+        reason = 0x78u;
+    }
+    else if (readiness->nmi_seen != 0u)
+    {
+        reason = 0x79u;
+    }
+    else if (export->bytes == 0u)
+    {
+        reason = 0x7au;
+    }
+    else if (export->bytes > R0FG1X_TRACE_CAPACITY)
+    {
+        reason = 0x7bu;
+    }
+    if (reason != 0u)
+    {
+        export->state = R0FG1X_S_FAILED;
+        return reason;
+    }
+    // Consumed before storage, including when transport later fails.
+    export->state = R0FG1X_S_EXPORTING;
+    return 0u;
+}
